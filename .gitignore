open-webui-data/
postgres-data/
pgdata/
ollama-models/
ollama/

# 7. Local Datasets & Telemetry (PCAPs, Logs, Large captures)
data/
*.pcap
*.pcapng
*.cap
*.log

# 8. Temporary / Scratch files
*.tmp
*.bak