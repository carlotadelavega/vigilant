# 1. Astral uv & Virtual Environments
.venv/
env/
venv/
ENV/
.uv/

# 2. Python bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 3. Static Type Checking & Code Quality (Mypy & Ruff)
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# 4. Testing & Coverage (Pytest)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover

# 5. Environment Variables, Secrets & Database Credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# 6. Docker & Persistent Service Volumes
