# Copy to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# --- Hermes Agent ---
# Shared secret between the hermes service (API_SERVER_KEY) and vigilant-backend
# (HERMES_API_KEY), used to authenticate FastAPI's calls to Hermes's OpenAI-compatible API.
HERMES_API_SERVER_KEY=change-me-to-a-strong-random-string

# --- vigilant-backend (FastAPI) ---
# Only needed to override the docker-compose defaults, e.g. for local (non-container) runs.
# HERMES_BASE_URL=http://localhost:8642/v1
# DEFAULT_LLM_MODEL=llama3.1
